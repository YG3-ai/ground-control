{
  "version": 1,
  "description": "Ground Control release candidate boundary (staging checks only; no runtime effect).",
  "includeGlobs": [
    ".env.example",
    ".gitignore",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    ".github/**",
    "config.example.yaml",
    "package.json",
    "package-lock.json",
    "tsconfig.base.json",
    "release/**",
    "packages/**",
    "scripts/**",
    "launchd/**",
    "docker/**",
    "fixtures/**",
    "docs/**",
    "config/**",
    "apps/menu-bar/Package.swift",
    "apps/menu-bar/Info.plist",
    "apps/menu-bar/Sources/**",
    "apps/menu-bar/Resources/**",
    "apps/menu-bar/scripts/**",
    "apps/menu-bar/assets/**"
  ],
  "excludeGlobs": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.vitest-tmp/**",
    "logs/**",
    "launchd/rendered/**",
    "data/**",
    "data/relay/yg3/**",
    "data/relay/yg3/raw/**",
    ".state/**",
    "work/**",
    "secrets/**",
    ".mission-backups/**",
    "apps/menu-bar/.build/**",
    "**/*.db",
    "**/*.db-journal",
    "**/*.db-wal",
    "**/*.db-shm",
    ".env",
    "config.yaml",
    "config.local.yaml",
    "config/cloudflared.yml",
    "**/*.pem",
    "**/*.key",
    ".agent-control/**",
    "fixtures/world-live-master/*.mp4",
    "fixtures/world-live-master/work/**"
  ],
  "forbiddenBasenames": [".env"],
  "forbiddenBasenamePrefixes": [".env."],
  "forbiddenBasenameExceptions": [".env.example"],
  "forbiddenExtensions": [".pem", ".key", ".db", ".db-journal", ".db-wal", ".db-shm"],
  "startupConfigGlobs": [
    "launchd/templates/**",
    "scripts/install-launchagents.sh",
    "scripts/install-cloudflared-launchagent.sh",
    "scripts/render-launchd-plist.sh",
    "scripts/ensure-services.sh",
    "scripts/run-relay.sh",
    "scripts/run-worker.sh",
    "scripts/run-ngrok.sh",
    "scripts/run-cloudflared.sh",
    "packages/relay/src/board-extensions/paths.ts",
    ".env.example",
    "config.example.yaml",
    "config/cloudflared.yml.example"
  ]
}
