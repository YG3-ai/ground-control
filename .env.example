# Copy to .env and fill in. Never commit real secrets.

# Worker authenticates to the relay with this token (separate from ChatGPT OAuth).
WORKER_TOKEN=replace-with-long-random-worker-token-min-24

# Relay signing / approval secrets (generate with: openssl rand -hex 32)
RELAY_JWT_SECRET=replace-with-long-random-jwt-secret-min-32-chars
OWNER_APPROVAL_SECRET=replace-with-approval-secret-you-type-in-browser

# Optional: separate key for the phone live board at https://YOUR_HOST/board
# Defaults to OWNER_APPROVAL_SECRET if unset. Open /board?k=YOUR_KEY once on phone.
# BOARD_VIEW_SECRET=replace-with-board-view-secret

# Temporary: expose /board + read-only board APIs without the owner key (writes still require key).
# BOARD_PUBLIC_READ_ONLY=1

# Anonymous demo CTAs (safe to publish; no secrets)
# PUBLIC_REPO_URL=https://github.com/YG3-ai/ground-control
# PUBLIC_DONATION_URL=https://buy.stripe.com/your-support-link

# Public unlock password (scrypt hash only — never commit plaintext). Generate:
#   printf '%s' 'your-password' | node packages/relay/scripts/hash-board-unlock-password.mjs
# BOARD_UNLOCK_PASSWORD_HASH=scrypt$...

# STABLE public HTTPS base URL ChatGPT will call.
# Do NOT use ephemeral ngrok URLs (they change and break the ChatGPT MCP plugin).
# Claim a free static domain: https://dashboard.ngrok.com/domains
# Example: PUBLIC_BASE_URL=https://your-stable-name.ngrok-free.app
# A phone VPN alone does NOT make a Mac localhost endpoint reachable by ChatGPT.
PUBLIC_BASE_URL=https://your-stable-name.ngrok-free.app

# Optional: override worker relay URL without editing config.yaml (derived from PUBLIC_BASE_URL in run-worker.sh if unset)
# RELAY_URL=wss://your-relay.example.com/worker

# Optional bind for local development
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
OWNER_ID=owner-local
RELAY_DATA_DIR=./data/relay

# ONLY for local automated tests. Must be 0/unset on any public deploy.
ALLOW_DEV_TOKEN=0

# --- Optional board extension adapters (not required for core relay/worker) ---
# GROUND_CONTROL_WORK_ROOT=/path/to/your/separate-product-workspace
# FUNNELS_LOOPBACK_URL=http://127.0.0.1:4141
# BRAIN_ROOT=/path/to/your/markdown-second-brain
# BRAIN_VAULT=/path/to/your/markdown-second-brain/vault
# BRAIN_PYTHON=/path/to/your/second-brain-venv/bin/python
# BRAIN_SCRIPT=/path/to/your/second-brain/brain.py
# BRAIN_OWNER_PROFILE_SLUG=your-profile-slug

# --- Optional Cloudflare tunnel (see config/cloudflared.yml.example) ---
# CLOUDFLARED_CONFIG=$HOME/.cloudflared/config.yml
# CLOUDFLARED_TUNNEL_NAME=ground-control

# --- Optional official YG3 MCP (read-only; disabled by default) ---
# Connect once via npm run yg3:login; background sync uses Keychain + local workspace selection.
# YG3_MCP_ENABLED=0
# YG3_MCP_URL=https://mcp.yg3.ai/mcp
