<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.groundcontrol.ngrok</string>
    <key>WorkingDirectory</key>
    <string>__GROUND_CONTROL_ROOT__</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>__GROUND_CONTROL_ROOT__/scripts/run-ngrok.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>__GROUND_CONTROL_ROOT__/logs/launchd-ngrok.out.log</string>
    <key>StandardErrorPath</key>
    <string>__GROUND_CONTROL_ROOT__/logs/launchd-ngrok.err.log</string>
  </dict>
</plist>
