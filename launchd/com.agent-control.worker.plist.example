<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to ~/Library/LaunchAgents/com.agent-control.worker.plist
  Update paths, then:
    launchctl load ~/Library/LaunchAgents/com.agent-control.worker.plist
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.agent-control.worker</string>
    <key>WorkingDirectory</key>
    <string>/Users/YOU/Projects/agent-control</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/YOU/.nvm/versions/node/v20.20.0/bin/npm</string>
      <string>run</string>
      <string>worker</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/usr/bin:/bin:/Users/YOU/.local/bin:/Users/YOU/.nvm/versions/node/v20.20.0/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/YOU/Projects/agent-control/data/worker/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOU/Projects/agent-control/data/worker/launchd.err.log</string>
  </dict>
</plist>
